<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Google Java Style Guide ベースのCheckstyle設定
  以下のチェックを無効化・緩和しています：
    - 行の最大文字数：120文字に緩和（デフォルト80 or 100）
    - Javadocコメント必須：無効化
    - import の '.*' 形式：許可
    - package-info.java 必須：無効化
    - パラメータの final 強制：無効化
-->
<module name="Checker">

  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java, properties, xml"/>

  <!-- ========================================
       ファイルレベルのチェック
       ======================================== -->

  <!-- タブ文字の使用禁止 -->
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <!-- ファイル末尾の改行 -->
  <module name="NewlineAtEndOfFile"/>

  <!-- ========================================
       ツリーウォーカー（Java構文解析）
       ======================================== -->
  <module name="TreeWalker">

    <!-- ========================================
         インポート
         ======================================== -->

    <!-- 未使用インポートの禁止 -->
    <module name="UnusedImports"/>

    <!-- 重複インポートの禁止 -->
    <module name="RedundantImport"/>

    <!-- ワイルドカードインポート（.*）は許可するため AvoidStarImport は無効化 -->
    <!-- <module name="AvoidStarImport"/> -->

    <!-- ========================================
         命名規則
         ======================================== -->

    <!-- パッケージ名：小文字のみ -->
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>

    <!-- クラス名：アッパーキャメルケース -->
    <module name="TypeName"/>

    <!-- メソッド名：ローワーキャメルケース -->
    <module name="MethodName"/>

    <!-- フィールド名：ローワーキャメルケース -->
    <module name="MemberName"/>

    <!-- ローカル変数名 -->
    <module name="LocalVariableName"/>

    <!-- パラメータ名 -->
    <module name="ParameterName"/>

    <!-- 定数名：UPPER_SNAKE_CASE -->
    <module name="ConstantName"/>

    <!-- 型パラメータ名：1文字大文字 または T で始まる -->
    <module name="ClassTypeParameterName">
      <property name="format" value="(^[A-Z][0-9]?)$|([A-Z][a-zA-Z0-9]*[T]$)"/>
    </module>
    <module name="MethodTypeParameterName">
      <property name="format" value="(^[A-Z][0-9]?)$|([A-Z][a-zA-Z0-9]*[T]$)"/>
    </module>

    <!-- ========================================
         ブロックとブレース
         ======================================== -->

    <!-- 空ブロックの禁止（コメントがある場合は許可） -->
    <module name="EmptyBlock">
      <property name="option" value="TEXT"/>
      <property name="tokens" value="LITERAL_WHILE, LITERAL_TRY, LITERAL_FINALLY,
                                     LITERAL_DO, LITERAL_IF, LITERAL_ELSE,
                                     LITERAL_FOR, INSTANCE_INIT, STATIC_INIT,
                                     LITERAL_SWITCH, LITERAL_SYNCHRONIZED"/>
    </module>

    <!-- ブレースは必須（if/for/whileなどで省略不可） -->
    <module name="NeedBraces"/>

    <!-- 左ブレースの位置（同一行） -->
    <module name="LeftCurly"/>

    <!-- 右ブレースの位置 -->
    <module name="RightCurly">
      <property name="id" value="RightCurlySame"/>
      <property name="tokens" value="LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY,
                                     LITERAL_IF, LITERAL_ELSE, LITERAL_DO"/>
    </module>
    <module name="RightCurly">
      <property name="id" value="RightCurlyAlone"/>
      <property name="option" value="alone"/>
      <property name="tokens" value="CLASS_DEF, METHOD_DEF, CTOR_DEF, LITERAL_FOR,
                                     LITERAL_WHILE, STATIC_INIT, INSTANCE_INIT,
                                     ANNOTATION_DEF, ENUM_DEF, INTERFACE_DEF,
                                     RECORD_DEF, COMPACT_CTOR_DEF"/>
    </module>

    <!-- ========================================
         空白・インデント
         ======================================== -->

    <!-- インデントは2スペース（Google Style） -->
    <module name="Indentation">
      <property name="basicOffset" value="2"/>
      <property name="braceAdjustment" value="0"/>
      <property name="caseIndent" value="2"/>
      <property name="throwsIndent" value="4"/>
      <property name="lineWrappingIndentation" value="4"/>
      <property name="arrayInitIndent" value="2"/>
    </module>

    <!-- 行末の空白禁止 -->
    <module name="Regexp">
      <property name="format" value="[ \t]+$"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="行末に空白があります"/>
    </module>

    <!-- キーワード後のスペース -->
    <module name="WhitespaceAfter">
      <property name="tokens" value="COMMA, SEMI, TYPECAST, LITERAL_IF, LITERAL_ELSE,
                                     LITERAL_WHILE, LITERAL_DO, LITERAL_FOR, DO_WHILE"/>
    </module>

    <!-- 演算子周りのスペース -->
    <module name="WhitespaceAround">
      <property name="allowEmptyConstructors" value="true"/>
      <property name="allowEmptyLambdas" value="true"/>
      <property name="allowEmptyMethods" value="true"/>
      <property name="allowEmptyTypes" value="true"/>
      <property name="allowEmptyLoops" value="true"/>
      <property name="ignoreEnhancedForColon" value="false"/>
    </module>

    <!-- 行の最大文字数：120文字に緩和 -->
    <!-- ※ Google Style Guide は 100文字だが、実務に合わせて 120文字に変更 -->
    <module name="LineLength">
      <property name="max" value="120"/>
      <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <!-- ========================================
         コード品質
         ======================================== -->

    <!-- switch の fall-through 禁止（コメントがある場合は許可） -->
    <module name="FallThrough"/>

    <!-- 複数の変数宣言を1行にまとめる禁止 -->
    <module name="MultipleVariableDeclarations"/>

    <!-- 配列型の宣言スタイル（Java スタイル強制：int[] x ではなく int x[]） -->
    <module name="ArrayTypeStyle"/>

    <!-- 修飾子の順序（JLS準拠） -->
    <module name="ModifierOrder"/>

    <!-- 冗長な修飾子の禁止（interface メソッドの public abstract など） -->
    <module name="RedundantModifier"/>

    <!-- 空のステートメント禁止（孤立したセミコロン） -->
    <module name="EmptyStatement"/>

    <!-- equals() で == を使った比較の禁止 -->
    <module name="StringLiteralEquality"/>

    <!-- オーバーライド時に hashCode もオーバーライドする -->
    <module name="EqualsHashCode"/>

    <!-- 隠れたフィールドの警告（ローカル変数がフィールドを隠す） -->
    <module name="HiddenField">
      <property name="ignoreSetter" value="true"/>
      <property name="ignoreConstructorParameter" value="true"/>
    </module>

    <!-- IllegalInstantiationの禁止 -->
    <module name="IllegalInstantiation"/>

    <!-- 不要なインポートの禁止（java.lang など） -->
    <module name="IllegalImport"/>

    <!-- ネストした if の else if 推奨（SimplifyBooleanExpression） -->
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>

    <!-- インターフェースのみ定数を持つことの禁止 -->
    <module name="InterfaceIsType"/>

    <!-- 可視性の制限（フィールドは private を推奨） -->
    <module name="VisibilityModifier">
      <property name="packageAllowed" value="false"/>
      <property name="protectedAllowed" value="true"/>
      <property name="allowPublicImmutableFields" value="true"/>
      <property name="ignoreAnnotationCanonicalNames"
                value="lombok.Getter, lombok.Setter, lombok.Data,
                       lombok.Value, lombok.Builder,
                       org.springframework.beans.factory.annotation.Autowired,
                       org.springframework.beans.factory.annotation.Value"/>
    </module>

    <!-- ========================================
         Javadoc（無効化）
         ======================================== -->

    <!-- JavadocMethod：無効化（メソッドへのJavadoc強制をしない） -->
    <!-- <module name="JavadocMethod"/> -->

    <!-- JavadocVariable：無効化（フィールドへのJavadoc強制をしない） -->
    <!-- <module name="JavadocVariable"/> -->

    <!-- JavadocType：クラス・インターフェースへのJavadocは任意 -->
    <!-- <module name="JavadocType"/> -->

    <!-- Javadocの書式チェック（Javadocが書かれている場合のみ適用） -->
    <module name="JavadocStyle">
      <property name="checkFirstSentence" value="false"/>
    </module>

    <!-- ========================================
         パラメータ final（無効化）
         ======================================== -->

    <!-- FinalParameters：無効化（パラメータへの final 強制をしない） -->
    <!-- <module name="FinalParameters"/> -->

    <!-- FinalLocalVariable：ローカル変数の final は任意 -->
    <!-- <module name="FinalLocalVariable"/> -->

    <!-- ========================================
         package-info.java（無効化）
         ======================================== -->

    <!-- JavadocPackage：無効化（package-info.java の強制をしない） -->
    <!-- <module name="JavadocPackage"/> -->

    <!-- ========================================
         その他
         ======================================== -->

    <!-- TODO コメントの検出（warningレベル） -->
    <module name="TodoComment">
      <property name="severity" value="warning"/>
      <property name="format" value="(TODO|FIXME|HACK|XXX):"/>
    </module>

    <!-- アノテーションの位置 -->
    <module name="AnnotationLocation">
      <property name="id" value="AnnotationLocationMostCases"/>
      <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF,
                                     METHOD_DEF, CTOR_DEF, RECORD_DEF,
                                     COMPACT_CTOR_DEF"/>
    </module>
    <module name="AnnotationLocation">
      <property name="id" value="AnnotationLocationVariables"/>
      <property name="tokens" value="VARIABLE_DEF"/>
      <property name="allowSamelineMultipleAnnotations" value="true"/>
    </module>

  </module>

  <!-- ========================================
       ファイル名とクラス名の一致
       ======================================== -->
  <module name="UniqueProperties">
    <property name="fileExtensions" value="properties"/>
  </module>

</module>
